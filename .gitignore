# Virtual Environment
.venv/
env/
venv/
ENV/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Jupyter Notebook checkpoints and runtime
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
.mplconfig/
*/.mplconfig/*
.ipython/
.jupyter_data/
.jupyter_config/
.jupyter_runtime/
.keras/

# Datasets (exclude large raw and processed image data)
datasets/raw/plantdoc/*
datasets/raw/new_plant_diseases/*
!datasets/raw/plantdoc/.gitkeep
!datasets/raw/new_plant_diseases/.gitkeep
datasets/cleaned/*
!datasets/cleaned/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep

# User uploaded images in web app
frontend/static/uploads/*
!frontend/static/uploads/.gitkeep

# Environment and local config files
.env
.env.local
.env.*.local
*.env

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Database files
*.db
database/*.db
!database/.gitkeep

# Model checkpoints and large binaries
model/*.h5
model/*.keras
model/*.tflite
model/*.onnx
!model/leaf_classifier.keras
!model/.gitkeep

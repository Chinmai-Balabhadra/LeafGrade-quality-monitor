# ==============================================================================
# CSE471 Academic Project: Leaf Quality Classification & Plucking System
# Environment Configuration Template (.env.example)
# Copy this file to .env and customize values for your deployment environment
# ==============================================================================

# Flask Environment Mode: 'production', 'development', or 'testing'
FLASK_ENV=production

# Application Secret Key (replace with a high-entropy random string for production)
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-key

# Server Network Binding
HOST=127.0.0.1
PORT=5000

# Security: Maximum Upload Payload Size in Bytes (default: 16 MB = 16777216 bytes)
MAX_CONTENT_LENGTH=16777216

# Inference & Quality Thresholds
# Default confidence cutoff below which predictions are flagged as UNCERTAIN_LOW_CONFIDENCE (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.40

# Laplacian variance threshold below which images trigger motion blur / defocus warnings
BLUR_THRESHOLD=50.0

# Database Persistence Path
DATABASE_PATH=database/leaf_analysis.db

# Cross-Origin Resource Sharing (CORS) Origins
# For local development: '*' or specific origin like 'http://127.0.0.1:5500'
CORS_ORIGINS=*

# Waitress WSGI Production Server Threads
WAITRESS_THREADS=4
